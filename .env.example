# ============================================================
# Akande - Environment Configuration
# ============================================================

# LLM provider to use (required)
# Available: openai, anthropic, google, ollama, azure_openai,
#            mistral, cohere, huggingface, groq, lmstudio
LLM_PROVIDER=openai

# ------------------------------------------------------------
# OpenAI (default provider)
# https://platform.openai.com/api-keys
# ------------------------------------------------------------
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_DEFAULT_MODEL=gpt-3.5-turbo

# ------------------------------------------------------------
# Anthropic
# https://console.anthropic.com/settings/keys
# ------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ------------------------------------------------------------
# Google Gemini
# https://aistudio.google.com/apikey
# ------------------------------------------------------------
# GOOGLE_API_KEY=your-google-api-key-here

# ------------------------------------------------------------
# Ollama (local)
# https://ollama.ai
# ------------------------------------------------------------
# OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------
# Azure OpenAI
# https://portal.azure.com
# ------------------------------------------------------------
# AZURE_OPENAI_API_KEY=your-azure-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_VERSION=2024-02-01

# ------------------------------------------------------------
# Mistral AI
# https://console.mistral.ai/api-keys
# ------------------------------------------------------------
# MISTRAL_API_KEY=your-mistral-key-here

# ------------------------------------------------------------
# Cohere
# https://dashboard.cohere.com/api-keys
# ------------------------------------------------------------
# COHERE_API_KEY=your-cohere-key-here

# ------------------------------------------------------------
# Hugging Face Inference API
# https://huggingface.co/settings/tokens
# ------------------------------------------------------------
# HUGGINGFACE_API_KEY=hf_your-token-here

# ------------------------------------------------------------
# Groq
# https://console.groq.com/keys
# ------------------------------------------------------------
# GROQ_API_KEY=gsk_your-key-here

# ------------------------------------------------------------
# LM Studio (local)
# https://lmstudio.ai
# ------------------------------------------------------------
# LMSTUDIO_HOST=http://localhost:1234

# ============================================================
# Server hardening (v0.0.6)
# ============================================================

# ------------------------------------------------------------
# AKANDE_API_KEY — shared secret for /api/* routes.
#
# When set, every request to /api/question, /api/audio, /api/export
# must include the matching value in the X-Akande-Key header.  When
# unset, the server starts with a warning and the API is open — this
# is convenient for local development but UNSAFE for anything exposed
# beyond localhost.  Use a strong random value (e.g. `openssl rand
# -base64 32`).
# ------------------------------------------------------------
# AKANDE_API_KEY=replace-me-with-a-strong-random-value

# ------------------------------------------------------------
# REDIS_URL — optional, enables distributed rate limiting.
#
# Without this the server uses an in-memory limiter, which is fine
# for a single process but resets on restart and is not shared
# across instances behind a load balancer.  Setting REDIS_URL switches
# to a sliding-window limiter backed by Redis.  Falls back to
# in-memory (with a warning) if Redis is unreachable.
# ------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0
